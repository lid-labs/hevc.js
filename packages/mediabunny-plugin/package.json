{
  "name": "@hevcjs/mediabunny-plugin",
  "version": "0.0.0",
  "description": "Mediabunny plugin for HEVC/H.265 decoding — registers a custom video decoder backed by @hevcjs/core where WebCodecs cannot decode HEVC",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "keywords": [
    "hevc",
    "h265",
    "h.265",
    "webassembly",
    "wasm",
    "codec",
    "video",
    "decoder",
    "browser",
    "mediabunny",
    "webcodecs",
    "custom-decoder"
  ],
  "author": "privaloops",
  "license": "MIT",
  "homepage": "https://hevcjs.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/lid-labs/hevc.js.git",
    "directory": "packages/mediabunny-plugin"
  },
  "bugs": {
    "url": "https://github.com/lid-labs/hevc.js/issues"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && mv dist/decode-worker.global.js dist/decode-worker.js && mv dist/decode-worker.global.js.map dist/decode-worker.js.map",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hevcjs/core": "workspace:*"
  },
  "peerDependencies": {
    "mediabunny": "^1.62.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "mediabunny": "^1.62.1",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
